{
  "manifest_version": 3,
  "name": "Nazzk Toolkit",
  "version": "1.0.0",
  "description": "치지직·카페 도구집",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["https://chzzk.naver.com/*", "https://api.chzzk.naver.com/*", "https://store.steampowered.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cafe.naver.com/*", "https://m.cafe.naver.com/*"],
      "js": ["cafe.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["steam/player.html", "steam/player.js"],
      "matches": ["https://cafe.naver.com/*", "https://m.cafe.naver.com/*"]
    }
  ],
  "action": {
    "default_title": "Chzzk Tools",
    "default_popup": "popup/popup.html"
  }
}
